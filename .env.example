# ============================================================
# CMDCA Pindamonhangaba — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ============================================================

# --- App ---
NEXT_PUBLIC_SERVER_URL=https://cmdca.onrender.com
PAYLOAD_SECRET=defina-um-segredo-forte-aleatorio
PREVIEW_SECRET=defina-um-segredo-de-preview

# --- Banco: Neon (PostgreSQL) ---
# App usa a string POOLED (-pooler); migrations/seed usam a UNPOOLED (direct).
# O app normaliza sslmode=require -> verify-full automaticamente (Neon tem
# certificado público válido), eliminando o aviso do driver pg.
DATABASE_URI=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URI_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Mídia: Cloudflare R2 (S3-compatible) ---
S3_BUCKET=cmdca-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# URL pública das imagens (R2 -> bucket -> Settings -> Public access)
NEXT_PUBLIC_R2_PUBLIC_URL=https://<public-hash>.r2.dev

# --- E-mail (reset de senha do painel) ---
# Opcional em dev: sem SMTP_HOST, o Payload registra o e-mail no console.
# Em produção, configure um SMTP real para o "esqueci minha senha" funcionar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=CMDCA Pindamonhangaba
EMAIL_FROM_ADDRESS=nao-responder@cmdca-pinda.local
