# CMDCA: somente site/CMS/PostgreSQL/mídia na VPS. Sem Vercel, Neon, R2 ou PWA.
# Modelo SEM segredos. Copie para .env.local apenas em ambiente local isolado.

# Dev: localhost. VPS: https://www.cmdcapinda.org (app.env protegido em /srv/sites/cmdca).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
ENFORCE_PRODUCTION_ENV=false
SITE_INDEXABLE=false

# Segredo de 32+ caracteres aleatórios (não reutilizar credenciais de produção).
PAYLOAD_SECRET=substitua-por-um-segredo-aleatorio-com-mais-de-32-caracteres

# PostgreSQL: em produção a plataforma injeta DATABASE_URL na rede Docker interna.
# Para desenvolvimento, use banco DESCARTÁVEL próprio. Nunca conecte o dev à base operacional.
DATABASE_URI=postgresql://cmdca_dev:senha-local@127.0.0.1:5432/cmdca_dev?sslmode=disable
# Conexão opcional, exclusiva para migrations. Se vazia, utiliza DATABASE_URI/DATABASE_URL.
DATABASE_URI_UNPOOLED=
# Diretório persistente de uploads; no Dockerfile de produção: /app/media.
MEDIA_DIR=./media

# Tentativas de login e recuperação por IP em 10 minutos (padrão 20).
LOGIN_RATE_LIMIT_MAX=

# SMTP é opcional. Sem SMTP_HOST não há recuperação automática por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=CMDCA Pindamonhangaba
EMAIL_FROM_ADDRESS=

# Seeds apenas em banco de teste descartável, nunca na VPS.
SEED_ALLOW_LOCAL=false
SEED_ADMIN_NAME=Administrador local
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Backup externo é configurado na plataforma, NÃO neste app:
# /srv/platform/.env: RESTIC_REPOSITORY_OFFSITE, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
