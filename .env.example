# CMDCA Pindamonhangaba — estrutura de variáveis, sem credenciais reais.
# Copie para .env.local somente para desenvolvimento. Nunca commite .env.local.

# Origem canônica. Localmente use localhost; no Coolify use o domínio HTTPS final.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Obrigatório true no container de produção. False somente no CI isolado/desenvolvimento.
ENFORCE_PRODUCTION_ENV=false

# Gere um valor aleatório com pelo menos 32 caracteres. Rotacionar encerra sessões.
PAYLOAD_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# Neon: runtime usa pooled; migrations usam direct/unpooled.
# O arquivo local existente aponta para a base operacional: somente leitura.
# Testes de escrita usam PostgreSQL descartável no Actions.
DATABASE_URI=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
DATABASE_URI_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full

# Cloudflare R2, compatível com S3. Prefira bucket/prefixo separado em desenvolvimento.
S3_BUCKET=cmdca-media-dev
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
NEXT_PUBLIC_R2_PUBLIC_URL=https://PUBLIC_HOST.example

# Recuperação de senha. Em produção, SMTP_HOST e um remetente validado são requisitos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=CMDCA Pindamonhangaba
# PENDENCIA: informar o remetente real validado pelo provedor SMTP.
EMAIL_FROM_ADDRESS=

# Seed somente em banco descartável. Nunca configurar no Coolify de produção.
SEED_ALLOW_LOCAL=false
SEED_ADMIN_NAME=Administrador local
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
