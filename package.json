{
  "name": "cmdca",
  "version": "1.0.0",
  "description": "Site institucional do CMDCA de Pindamonhangaba",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "clean": "rimraf .next tsconfig.tsbuildinfo",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "pnpm clean && pnpm dev",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm clean && pnpm check && pnpm build",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_MIGRATION=true payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_MIGRATION=true payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_MIGRATION=true payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_MIGRATION=true tsx src/seed/index.ts",
    "apply:confirmados": "cross-env NODE_OPTIONS=--no-deprecation DATABASE_MIGRATION=true tsx src/seed/apply-confirmados.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^16.14.2",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "payload": "3.86.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
